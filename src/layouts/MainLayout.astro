---
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/700.css";
import "@fontsource/playfair-display/700.css";


import "../styles/globals.css";

interface Props {
	title?: string;
}

const {
	title = "Mariapaz | Un cuento lleno de magia"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">

<head>

	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>{title}</title>
	<meta name="description" content="Acompáñanos a celebrar la dulce espera de nuestra princesa Mariapaz. Una invitación interactiva llena de amor y magia." />
	<meta name="theme-color" content="#1d2748" />

	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

	<meta property="og:type" content="website" />
	<meta property="og:title" content={title} />
	<meta property="og:description" content="Acompáñanos a celebrar la dulce espera de nuestra princesa Mariapaz. Una invitación interactiva llena de amor y magia." />
	<meta property="og:image" content="/images/castle-premium.webp" />

	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content="Acompáñanos a celebrar la dulce espera de nuestra princesa Mariapaz." />
	<meta name="twitter:image" content="/images/castle-premium.webp" />

</head>

<body>

	<slot />

	<script>

		import { initAnimations } from "../lib/animations";
	
		window.addEventListener("load", () => {
	
			initAnimations();
	
		});
	
	</script>

</body>

</html>