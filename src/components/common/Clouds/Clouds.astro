---
import styles from "./Clouds.module.css";
---

<div class={styles.wrapper} aria-hidden="true">

    <img
        src="/images/cloud-left.svg"
        alt=""
        class={`${styles.cloud} ${styles.left}`}
        draggable="false"
    />

    <img
        src="/images/cloud-right.svg"
        alt=""
        class={`${styles.cloud} ${styles.right}`}
        draggable="false"
    />

</div>