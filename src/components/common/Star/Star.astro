---
import styles from "./Star.module.css";

interface Props{

size:number;

left:number;

top:number;

delay:number;

duration:number;

}

const{

size,

left,

top,

delay,

duration

}=Astro.props;
---

<img

src="/src/assets/illustrations/star.svg"

alt=""

aria-hidden="true"

class={styles.star}

style={`
left:${left}%;

top:${top}%;

width:${size}px;

animation-delay:${delay}s;

animation-duration:${duration}s;

`}

/>