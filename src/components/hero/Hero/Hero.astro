---
import styles from "./Hero.module.css";
---

<section class={styles.hero}>
  <div class={styles.content}>
    <h1 data-animate="hero-title" class={styles.title}>
      Todo gran cuento
      <br />
      comienza con
      <br />
      un pequeño milagro
    </h1>

    <p data-animate="hero-description" class={styles.subtitle}>
      Te invitamos a descubrir el primer capítulo de una historia que muy pronto
      llenará nuestras vidas de amor, ilusión y momentos inolvidables.
    </p>


    <div data-animate="hero-scroll" class={styles.scrollIndicator}>
      <span></span>
    </div>
  </div>
</section>
