---
import styles from "./Section.module.css";

interface Props{

    id?:string;

    class?:string;

}

const{

    id,

    class:className=""

}=Astro.props;
---

<section

    id={id}

    class={`${styles.section} ${className}`}

>

    <div class={styles.container}>

        <slot />

    </div>

</section>