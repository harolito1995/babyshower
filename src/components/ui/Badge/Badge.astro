---
import styles from "./Badge.module.css";

interface Props{

    icon?:string;

    text:string;

    class?:string;

    [key: string]: any;

}

const{

    icon,

    text,

    class: className = "",

    ...rest

}=Astro.props;
---

<div
    class={`${styles.badge} ${className}`}
    data-badge
    aria-label={text}
    {...rest}
>

    {

        icon && (

            <span
                class={styles.icon}
                aria-hidden="true"
            >

                {icon}

            </span>

        )

    }

    <span>

        {text}

    </span>

</div>