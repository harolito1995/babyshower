---
import styles from "./AudioPlayer.module.css";
---

<button
    id="audio-player-toggle"
    class={styles.playerButton}
    type="button"
    aria-label="Reproducir música mágica de cuna"
    aria-pressed="false"
    title="Reproducir música mágica"
>
    <div class={styles.icon} id="audio-player-icon">
        <svg class={styles.playIcon} viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 5v14l11-7z" fill="currentColor" />
        </svg>
        <svg class={styles.pauseIcon} viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" fill="currentColor" />
        </svg>
    </div>
</button>

<script>
    let isPlaying = false;
    let audioContext: AudioContext | null = null;
    let masterGain: GainNode | null = null;
    let melodyTimer: number | null = null;

    const button = document.getElementById("audio-player-toggle");

    // Musical Frequencies (Hz)
    const G3 = 196.00, C4 = 261.63, D4 = 293.66, E4 = 329.63, F4 = 349.23, FS4 = 369.99, G4 = 392.00;
    const A4 = 440.00, B4 = 493.88, C5 = 523.25, D5 = 587.33, E5 = 659.25, F5 = 698.46, G5 = 783.99;

    interface NoteStep {
        m: number;
        b?: number;
        d: number;
    }

    // Brahms' Lullaby (Canción de cuna / Wiegenlied)
    const brahmLullaby: NoteStep[] = [
        { m: G4, b: C4, d: 1 },
        { m: G4, d: 1 },
        { m: B4, b: E4, d: 2 },
        { m: G4, d: 1 },
        { m: G4, d: 1 },
        { m: B4, b: C4, d: 2 },
        { m: G4, d: 1 },
        { m: B4, d: 1 },
        { m: D5, b: G4, d: 1.5 },
        { m: C5, d: 0.5 },
        { m: B4, d: 1 },
        { m: A4, b: D4, d: 2 },

        { m: FS4, d: 1 },
        { m: G4, d: 1 },
        { m: A4, b: D4, d: 2 },
        { m: FS4, d: 1 },
        { m: G4, d: 1 },
        { m: A4, b: FS4, d: 2 },
        { m: A4, d: 1 },
        { m: C5, b: D4, d: 1.5 },
        { m: B4, d: 0.5 },
        { m: A4, d: 1 },
        { m: G4, b: G3, d: 2.5 },

        { m: D4, b: G3, d: 1 },
        { m: D5, b: B4, d: 2 },
        { m: B4, d: 1 },
        { m: G4, b: E4, d: 2 },
        { m: C5, b: C4, d: 1 },
        { m: B4, d: 1.5 },
        { m: A4, d: 0.5 },
        { m: D4, b: D4, d: 2 },

        { m: D4, d: 1 },
        { m: D5, b: FS4, d: 2 },
        { m: C5, d: 1 },
        { m: A4, b: D4, d: 2 },
        { m: B4, b: G4, d: 1 },
        { m: C5, d: 1 },
        { m: D5, b: B4, d: 1.5 },
        { m: G4, b: C4, d: 2.5 }
    ];

    let currentStep = 0;
    const beatUnitMs = 400;

    function getAudioContext(): AudioContext {
        if (!audioContext) {
            const AudioCtx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
            audioContext = new AudioCtx();
            masterGain = audioContext.createGain();
            masterGain.gain.setValueAtTime(0.42, audioContext.currentTime);
            masterGain.connect(audioContext.destination);
        }
        return audioContext;
    }

    function playBellChime(ctx: AudioContext, freq: number, isBass = false) {
        if (!isPlaying) return;

        const now = ctx.currentTime;
        const osc1 = ctx.createOscillator();
        const osc2 = ctx.createOscillator();
        const noteGain = ctx.createGain();

        // Sine wave for pure pitch
        osc1.type = "sine";
        osc1.frequency.setValueAtTime(freq, now);

        // Triangle wave for warm music box tine resonance
        osc2.type = "triangle";
        osc2.frequency.setValueAtTime(freq * 2, now);

        const volume = isBass ? 0.28 : 0.45;
        const decayTime = isBass ? 1.6 : 1.25;

        noteGain.gain.setValueAtTime(0.0001, now);
        noteGain.gain.linearRampToValueAtTime(volume, now + 0.015);
        noteGain.gain.exponentialRampToValueAtTime(0.0001, now + decayTime);

        osc1.connect(noteGain);
        osc2.connect(noteGain);

        if (masterGain) {
            noteGain.connect(masterGain);
        } else {
            noteGain.connect(ctx.destination);
        }

        osc1.start(now);
        osc1.stop(now + decayTime + 0.05);

        osc2.start(now);
        osc2.stop(now + decayTime + 0.05);
    }

    function scheduleNextNote(ctx: AudioContext) {
        if (!isPlaying) return;

        const step = brahmLullaby[currentStep];

        // Play melody note
        playBellChime(ctx, step.m, false);

        // Play harmonic accompaniment
        if (step.b) {
            playBellChime(ctx, step.b, true);
        }

        const durationMs = step.d * beatUnitMs;

        melodyTimer = window.setTimeout(() => {
            if (!isPlaying) return;
            currentStep = (currentStep + 1) % brahmLullaby.length;
            scheduleNextNote(ctx);
        }, durationMs);
    }

    function startLullaby(ctx: AudioContext) {
        if (melodyTimer) clearTimeout(melodyTimer);
        currentStep = 0;
        scheduleNextNote(ctx);
    }

    function stopLullaby() {
        if (melodyTimer) {
            clearTimeout(melodyTimer);
            melodyTimer = null;
        }
    }

    async function toggleAudio() {
        const ctx = getAudioContext();

        // Essential for iOS Safari / Android: resume synchronously within direct user interaction
        if (ctx.state === "suspended") {
            await ctx.resume();
        }

        // Silent unlock burst to ensure hardware audio pipeline is active on mobile
        try {
            const unlockBuf = ctx.createBuffer(1, 1, 22050);
            const unlockSrc = ctx.createBufferSource();
            unlockSrc.buffer = unlockBuf;
            unlockSrc.connect(ctx.destination);
            unlockSrc.start(0);
        } catch (_) {}

        if (!isPlaying) {
            isPlaying = true;
            button?.setAttribute("aria-pressed", "true");
            startLullaby(ctx);
        } else {
            isPlaying = false;
            button?.setAttribute("aria-pressed", "false");
            stopLullaby();
        }
    }

    button?.addEventListener("click", toggleAudio);
</script>
