---
import styles from "./Event.module.css";

import Badge from "../../ui/Badge/Badge.astro";
import GlassCard from "../../ui/GlassCard/GlassCard.astro";
import PrimaryButton from "../../ui/PrimaryButton/PrimaryButton.astro";
import SectionTitle from "../../ui/SectionTitle/SectionTitle.astro";
import PlushDecorations from "../../ui/PlushDecorations/PlushDecorations.astro";

import { eventData } from "./event";
---

<section class={styles.section} id="event">

    <PlushDecorations section="event" />

    <div class={styles.container}>
        <Badge
            text="El gran encuentro"
        />

        <SectionTitle>

            El lugar donde
            comenzará esta historia
        
        </SectionTitle>

        <p class={styles.intro} data-intro>

            Toda historia inolvidable merece un lugar especial.
            Nos encantará compartir contigo el comienzo de este nuevo capítulo.

        </p>

        <div class={styles.cardGroup}>

            <GlassCard class={styles.card} data-card>

                <div class={styles.row}>

                    <span class={styles.label}>Fecha</span>

                    <strong>{eventData.date}</strong>

                </div>

                <div class={styles.row}>

                    <span class={styles.label}>Hora</span>

                    <strong>{eventData.hour}</strong>

                </div>

                <div class={styles.row}>

                    <span class={styles.label}>Lugar</span>

                    <strong>{eventData.place}</strong>

                </div>

                <p class={styles.address}>

                    {eventData.address}

                </p>

                <div class={styles.actionsWrapper}>

                    <PrimaryButton
                        href={eventData.maps}
                        target="_blank"
                    >
                        Abrir ubicación
                    </PrimaryButton>

                    <a
                        href={eventData.googleCalendar}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={styles.calendarButton}
                        data-button
                        aria-label="Agendar Baby Shower en mi calendario"
                    >
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        <span>Agendar en calendario</span>
                    </a>

                </div>

            </GlassCard>

        </div>

    </div>

</section>